# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=hify
MYSQL_USER=hify
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

# Redis. Leave empty to disable password in local development.
REDIS_PASSWORD=
REDIS_PORT=6379

# PostgreSQL + pgvector
POSTGRES_USER=hify
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hify_vector
POSTGRES_PORT=5433

# Hify services
FRONTEND_PORT=80
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=default
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom

# Optional model API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
